# Keep the checkout identical on every platform.
#
# Without this, Git for Windows applies core.autocrlf=true and hands the
# working tree CRLF line endings. That is what made every multi-line `edit`
# fail there, and it turns any rewrite of a file into a whole-file diff.
# The tools now cope with CRLF either way (src/tools/line-endings.js), but the
# repository's own sources have no reason to carry it.
* text=auto eol=lf

# Windows-native scripts must keep CRLF or the shells that run them misparse.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary: never touched, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.woff binary
*.woff2 binary
*.pdf binary
